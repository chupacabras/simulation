TEXT 328 984 Left 2 !.tran 100000n\n;.ac oct 1000 1 10meg
TEXT 328 1112 Left 2 !.func wc(nom,tol,index) if(run==numruns,nom,if(binary(run,index),nom*(1+tol),nom*(1-tol)))\n.func binary(run,index) floor(run/(2**index))-2*floor(run/(2**(index+1)))
TEXT 1752 -88 Left 2 !.param R1 560k\n.param C1 10p\n.param RC1 0.05\n.param R2 56k\n;.step param C 1p 3p 0.5p\n.param C2 240p\n;.step param C2 230p 250p 5p\n.param RC2 0.05\n.param R3 0k5\n.param R4 1k-{R3}\n \n;.step param run 0 2 1\n.param numruns=2\n.param tola=.01\n.param tolb=.05\n.param tolc=.20\n.param parL=2n\n \n.param R5 500\n.param R6 500\n.param C5 1e-20\n;.step param C5 1p 10p 1p\n.param C6 0.5p\n;.param C6 0.5e-30\n;.step param C6 list 0.1f 1p 1.8p 2p 2.2p 10p\n;.step param C6 list 0.5p 1p 2p\n \n.param Ci 3p \n;.step param Ci list 0.1f 1p 1.8p 5p 10p\n;.step param Ci list 3p 4p 5p\n.param Ri 100\n;.step param Ri list 10 80 100 120\n \n.param Ra 910\n;.step param Ra 900 1200 100\n \n.param Cpcb 0.5p\n \n.param Rdiff -500

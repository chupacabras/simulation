*model for MAX4209
*version 0: 5/2016
**************************************************************************************
.subckt MAX4209 REFM IN- IN+ VSS VDD OUT FB REF
R+ IN+ ib+ 2g
R- IN- ib- 2g
Vi+ ib+ 0 0
Vi- ib- 0 0
GFi+ IN+ 0 VALUE={-I(Vi+)+1.5p}
GFi- IN- 0 VALUE={-I(Vi-)+0.5p}
Rs+ IN+ rsp 100
Cs+ rsp IN- 200n
Err REFr 0 REF 0 1
Eo OUT2 REFr VALUE={((V(rsp)-V(IN-))+(1u+V(cmr)+V(psr)+V(cmrR)+V(cmr2)+V(psr2)-18.45u)*V(vcchp))*100*V(vcchp)}
Esc sc GND VALUE={(V(hp)-1)}
Ecmr cmr 0 VALUE={(V(IN+)+V(IN-))/2*17.76e-8}
Rcmr cmr cmr1 100
Ccmr cmr1 0 100n
Ecmr2 cmr2 0 value={10u-0.992*V(cmr1)}
Rpsr psr psr1 100
Cpsr psr1 0 100n
Epsr2 psr2 0 value={10u-0.992*V(psr1)}
EcmrR cmrR 0 VALUE={V(REF)*17.76e-8}
Ecmrm cmrm 0 VALUE={V(REFM)*17.79e-8}
Epsr psr 0 VALUE={V(vdd)*53.76e-8}
Elim lim lim1 vdd 0 1
Elim1 lim1 0 VALUE={-0.77-0.4*V(sc)}
Dlim lim2 lim DX1
Vll ll 0 775m
Dlim1 ll1 OUT DX1
Sll ll ll1 ctl2 0 smod2
Slim2 OUT lim2 ctl2 0 smod2
Ectl2 ctl2 0 table {V(out)} =(-11,1) (-0.000001,1) (0,0) (0.005,0) (0.00501,1) (4.99999,1) (4.9999901,0) (8,0)
X_cs 0 vdd hp shdn
X_vcchp 0 vdd vcchp shdn
Eref2 REF2 0 VALUE={V(REFM)+10u+V(cmrm)+V(psr)}
So2 REF REF2 ctl1 0 smod1
Gref REF 0 value={999.9u*(V(IN+)-V(IN-))+10n}
Ectl1 ctl1 0 table {V(REFM)} = (0,0) (0.19,0) (0.191,1) (3.8,1) (3.801,0) (8,0)
Eref1 REF1 0 VALUE={V(vdd)-1.2}
Ectl ctl 0 VALUE={if(V(REFM)>V(REF1),0,1)}
So1 OUT1 OUT2 ctl 0 smod1
.model smod1 VSWITCH (Ron=0.1 Roff=10g Von=0.8 Voff=0.5)
.model smod2 VSWITCH (Ron=0.01 Roff=10g Von=0.8 Voff=0.5)
Irefm refm 0 1p
.MODEL DX1  D(n=1)
GCC VDD VSS VALUE={0.75m*V(ctl)+0.65m*V(ctl1)+0.4u}
Ectl4 ctl4 0 value={if(V(OUT)==0,1,0)}
*Ro OUT2 OUT1 0.1
D401 OUT1 IO1 DY
D402 IO2 OUT1 DY
D403 OUT IO1 DY
D404 IO2 OUT DY
G400 IO1 IO2 value={25m-5m*V(ctl4)}
.MODEL DY D(IS=100E-14 N=1)
.ends
***********************************************************************
.SUBCKT SHDN 18 91 cs
***********************************************************************
V10 10 0 5
E20 20 18 10 18 0.5
Ecs cs 18 VALUE={V(96)-V(20)}
*SHUTDOWN
RSHIN 91 20 5000K
ESH3 220 20 91 18 1
RSHA 220 221 1K
CSHA 221 20 32P
ESH2 92 20 221 20 1
RSH1 92 93 100
VSH1 93 94 0V
EHYS 95 94 POLY(2) 10 18 96 20 0 0 0 0 0.33
RBL 94 20 10K  
ESH1 95 20 10 18 0.45
****
E96 96 18 value={if(I(vsh1)<0,2.5,3.5)}
.MODEL DA D(N=10M)
*.MODEL DA D
.ends
